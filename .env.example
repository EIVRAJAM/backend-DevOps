# ==========================================
# BASE DE DATOS
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/db_devops
DB_USER=postgres
DB_PASSWORD=tu_password

# ==========================================
# APLICACION
# ==========================================
PORT=3020
SPRING_PROFILES_ACTIVE=local

# ==========================================
# SMTP (Mailtrap desarrollo / Brevo produccion)
# ==========================================
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=tu_username_mailtrap
MAIL_PASSWORD=tu_password_mailtrap
MAIL_FROM=noreply@eventosapp.com
MAIL_DEBUG=false

# ==========================================
# OAUTH2 GOOGLE
# ==========================================
GOOGLE_OAUTH_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-tu_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3020/login/oauth2/code/google
OAUTH2_FRONTEND_URL=http://localhost:5173

# ==========================================
# STRIPE
# ==========================================
STRIPE_API_KEY=sk_test_ejemplo
STRIPE_WEBHOOK_SECRET=whsec_ejemplo

# ==========================================
# TICKET CHECKOUT
# ==========================================
TICKET_CHECKOUT_EXPIRATION_MINUTES=15
TICKET_CHECKOUT_EXPIRATION_SCAN_MS=300000
